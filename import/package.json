{
  "name": "import",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "clear-down-missives": "rm -f ../src/content/missivz/*",
    "copy-images": "mkdir -p ../public/assets/images && dotenv -e ../.env -- sh -c 'cp -r ${LARAVEL_IMAGES}/* ../public/assets/images/'",
    "start": "npm run clear-down-missives && npm run copy-images && dotenv -e ../.env -- sh -c 'node app.js'",
    "test-env": "npm run import-laravel-images && npm run import-laravel-data",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "dotenv-cli": "^7.4.4"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
