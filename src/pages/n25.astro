---
import Layout from "../layouts/Layout.astro";

import HeaderSmall from "../components/HeaderSmall.astro";
import Form from "../components/Form.astro";
const title = "Minimal Viable Kubernetes";
const subtitle = "November 2025";

const data = {
  presentation: [
    {
      title: "Slide Show",
      href: "http://n25.headshed.dev/",
    },
    // {
    //   title: "Presenter Mode",
    //   href: "http://n25.headshed.dev/presenter/",
    // },
    // {
    //   title: "Slides Overview",
    //   href: "http://n25.headshed.dev/overview/",
    // },
    // {
    //   title: "Export Slides",
    //   href: "http://n25.headshed.dev/export/",
    // },
    // {
    //   title: "Remote Control (pass --remote to enable)",
    //   href: "#",
    // },
  ],
};
---

<Layout title="November 2025">
  <div>
    <HeaderSmall title={title} subtitle={subtitle} />
  </div>
  <main>
    <ul
      class="flex flex-col flex-wrap items-center justify-center text-gray-900 dark:text-white"
    >
      {
        data.presentation.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mr-4 hover:underline md:mr-6"
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <div class="flex-1"></div>
</Layout>

<style></style>
