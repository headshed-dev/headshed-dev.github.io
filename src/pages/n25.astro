---
import Layout from "../layouts/Layout.astro";

import HeaderSmall from "../components/HeaderSmall.astro";
import Form from "../components/Form.astro";
const title = "Minimal Viable Kubernetes";
const subtitle = "October 30th 2025";

const data = {
  presentation: [
    {
      title: "Slide Show",
      href: "http://n25.headshed.dev/",
    },
    {
      title: "Slide Show Code",
      href: "https://codeberg.org/marshyon/n25",
    },
    {
      title: "Minimal Viable Kubernetes Documentation",
      href: "https://mvk.headshed.dev/",
    },
    {
      title: "Minimal Viable Kubernetes and infctl source",
      href: "https://codeberg.org/headshed/infctl-cli",
    },
    {
      title: "N25Q - Feedback Form",
      href: "https://n25q.headshed.dev",
    },
  ],
};
---

<Layout title="November 2025">
  <div>
    <HeaderSmall title={title} subtitle={subtitle} />
  </div>
  <main>
    <ul
      class="flex flex-col flex-wrap items-center justify-center text-gray-900 dark:text-white"
    >
      {
        data.presentation.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mr-4 hover:underline md:mr-6"
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <div class="flex-1"></div>
</Layout>

<style></style>
